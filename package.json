{
  "name": "curtume-system-backend",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typeorm": "typeorm-ts-node-commonjs",
   
    "migration:create:main": "node src/scripts/comandos_bash/run-migration.js create main",
    "migration:generate:main": "node src/scripts/comandos_bash/run-migration.js generate main",
    "migration:run:main": "node src/scripts/comandos_bash/run-migration.js run main",
    "migration:revert:main": "node src/scripts/comandos_bash/run-migration.js revert main",
    "migration:show:main": "node src/scripts/comandos_bash/run-migration.js show main",

    "migration:create:rastreabilidade": "node src/scripts/comandos_bash/run-migration.js create rastreabilidade",
    "migration:generate:rastreabilidade": "node src/scripts/comandos_bash/run-migration.js generate rastreabilidade",
    "migration:run:rastreabilidade": "node src/scripts/comandos_bash/run-migration.js run rastreabilidade",
    "migration:revert:rastreabilidade": "node src/scripts/comandos_bash/run-migration.js revert rastreabilidade",
    "migration:show:rastreabilidade": "node src/scripts/comandos_bash/run-migration.js show rastreabilidade"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "glob": "^11.0.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  }
}
